# The HTTP service (web/) and its one-shot migration (alembic -c web/alembic.ini upgrade head).
#
# Build context: the repository root, filtered by the allow-list in .dockerignore.
# Python dependencies come only from uv.lock (`server` extra: web, database and
# sandbox control stacks).
# The final stage holds the virtual environment and the first-party paths below:
# no uv, compilers, tests or docs. Bases are pinned by digest; see
# docs/guides/development.md#images.
FROM ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 AS uv

FROM python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --no-cache --extra server

FROM python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=dependencies /opt/venv /opt/venv
WORKDIR /app
COPY sandbox_config.yml ./
COPY autograder autograder
COPY execution_host execution_host
COPY sandbox_manager sandbox_manager
COPY web web
RUN python -m compileall -q /app

# Remote sandbox mode needs no Docker here; local mode talks to a mounted
# socket through the Docker SDK, never a CLI or daemon in this image.
EXPOSE 8000
CMD ["uvicorn", "web.main:app", "--host", "0.0.0.0", "--port", "8000"]
