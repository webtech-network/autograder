# 1. Use an official Python image as the base
FROM python:3.13-slim

# 2. Python dependencies come only from the committed lock (uv.lock)
COPY --from=ghcr.io/astral-sh/uv:0.11.15 /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# 3. Install Node.js and other necessary tools
RUN apt-get update && \
    apt-get install -y tree curl gnupg git && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# 4. Set the working directory for the rest of the build
WORKDIR /app

# 5. Copy the rest of your application code
COPY . .

# 6. Install the project (editable) and its locked engine and Action
#    dependencies: no server extra, no test, lint or docs tools
RUN uv sync --locked --no-dev --no-cache

# 7. Make the repository entrypoint executable
RUN chmod +x github_action/entrypoint.sh

# 8. Set the entrypoint for the container
ENTRYPOINT ["/app/github_action/entrypoint.sh"]

