# 1. Use an official Python image as the base
FROM python:3.13-slim

# 2. Python dependencies come only from the committed lock (uv.lock)
COPY --from=ghcr.io/astral-sh/uv:0.11.15 /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# 3. Install system dependencies including Docker CLI
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    docker.io \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 4. Set the working directory
WORKDIR /app

# 5. Install the locked runtime dependencies (no test, lint or docs tools)
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --extra server --no-install-project --no-cache

# 6. Copy the rest of the application code and install it (editable, so the
#    packages in /app are importable from any directory)
COPY . .
RUN uv sync --locked --no-dev --extra server --no-cache

# 7. The private control API port. Do not publish it; keep it on an internal
#    network and set SANDBOX_API_TOKEN (the service refuses to start without it).
EXPOSE 8001

# 8. Exactly one worker: sandbox handles live in this process's memory.
CMD ["uvicorn", "sandbox_manager.api:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
