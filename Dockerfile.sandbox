# 1. Use an official Python image as the base
FROM python:3.11-slim

# 2. Set environment variables
ENV PYTHONUNBUFFERED=1

# 3. Install system dependencies including Docker CLI
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    docker.io \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 4. Set the working directory
WORKDIR /app

# 5. Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 6. Copy the rest of the application code
COPY . .

# 7. Expose the port the Sandbox Manager API runs on
EXPOSE 8001

# 8. Define the command to run the Sandbox Manager API
CMD ["uvicorn", "sandbox_manager.api:app", "--host", "0.0.0.0", "--port", "8001"]
