# The private sandbox control API (sandbox_manager.api).
#
# Build context: the repository root, filtered by the allow-list in .dockerignore.
# Python dependencies come only from uv.lock (`sandbox` extra: no web or
# database stack).
# The final stage holds the virtual environment and the first-party paths below:
# no uv, compilers, tests or docs. Bases are pinned by digest; see
# docs/guides/development.md#images.
FROM ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 AS uv

FROM python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --no-cache --extra sandbox

FROM python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=dependencies /opt/venv /opt/venv
WORKDIR /app
COPY sandbox_config.yml ./
COPY autograder autograder
COPY sandbox_manager sandbox_manager
RUN python -m compileall -q /app

# Links the published package to this repository, so main's workflow token can push it.
LABEL org.opencontainers.image.source="https://github.com/webtech-network/autograder"

# It manages sandboxes through the mounted Docker socket with the Docker SDK.
# The private control API port: do not publish it; keep it on an internal
# network and set SANDBOX_API_TOKEN (the service refuses to start without it).
EXPOSE 8001
# Exactly one worker: sandbox handles live in this process's memory.
CMD ["uvicorn", "sandbox_manager.api:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
