# Student runtime for `python`: CPython 3.13 on Alpine 3.24.
# Built without a build context (see scripts/sandbox_images.py); never COPY or ADD.
FROM python:3.13-alpine3.24@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8

LABEL autograder.runtime.languages="python"

# Students get the interpreter only: no package managers or downloaders, no
# setuid binaries, and an unprivileged user.
RUN rm -rf /usr/local/bin/pip* /usr/local/lib/python3.13/site-packages/pip* \
        /usr/local/lib/python3.13/ensurepip \
    && rm -rf /sbin/apk /etc/apk /lib/apk /usr/share/apk /var/cache/apk \
    && rm -f /usr/bin/wget /usr/bin/curl /usr/bin/nc \
    && find / -xdev -perm /6000 -type f -exec chmod a-s {} + \
    && addgroup -S sandbox && adduser -S sandbox -G sandbox \
    && mkdir -p /app && chown sandbox:sandbox /app

WORKDIR /app
# Pools always mount a bounded tmpfs here (sandbox_manager/docker_profile.py).
VOLUME ["/app"]
USER sandbox
CMD ["python3"]
